# Campus Customs — environment variables
# Copy this file to `.env` (in this hw4/ folder) and fill in your real values.
# NEVER commit your real .env.

# Required: OpenAI access via Portkey (used by the PydanticAI agent).
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional overrides (defaults shown):
# CAMPUS_CHAT_MODEL=gpt-5.6-luna
# CAMPUS_PBKDF2_ITERATIONS=260000
# CAMPUS_SECRET_KEY=change-me-in-production
